@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="letter-spacing: 0.5px;">Quản lý Khách hàng</h2>
        <a href="#" class="btn btn-success fw-semibold px-3 py-2">
            + Thêm khách hàng mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-dark fw-bold border-bottom">
                    <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: 20%;">Họ và tên</th>
                        <th style="width: 20%;">Email</th>
                        <th style="width: 15%;">Số điện thoại</th>
                        <th style="width: 25%;">Địa chỉ nhận hàng</th>
                        <th style="width: 15%;" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium text-secondary">@item.Id</td>
                            <td class="fw-bold text-dark">@item.FullName</td>
                            <td class="text-primary">@item.Email</td>
                            <td>@item.Phone</td>
                            <td class="text-muted text-truncate" style="max-width: 250px;" title="@item.Address">
                                @item.Address
                            </td>
                            <td class="text-center">
                                <a href="#" class="btn btn-sm btn-outline-warning text-dark border-warning fw-semibold me-1 px-2.5">Sửa</a>
                                <a href="#" class="btn btn-sm btn-outline-danger fw-semibold px-2.5" onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>