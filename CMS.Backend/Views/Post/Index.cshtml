@model IEnumerable<CMS.Data.Entities.Post>


<div class="container mt-4">
    <h2 class="mb-4">Tin tức mới nhất</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@item.Category?.Name</span>
                        <h5 class="card-title text-truncate">@item.Title</h5>
                        <p class="card-text text-muted" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Content
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 text-muted small">
                        Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        }
    </div>
</div>