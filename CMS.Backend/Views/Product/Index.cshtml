@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="letter-spacing: 0.5px;">Quản lý Sản phẩm</h2>
        <a href="#" class="btn btn-success fw-semibold px-3 py-2">
            + Thêm sản phẩm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-dark fw-bold border-bottom">
                    <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: 10%;">Hình ảnh</th>
                        <th style="width: 25%;">Tên sản phẩm</th>
                        <th style="width: 15%;">Danh mục</th>
                        <th style="width: 15%;">Giá bán</th>
                        <th style="width: 10%;" class="text-center">Kho</th>
                        <th style="width: 20%;" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium text-secondary">@item.Id</td>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid #eee;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">@item.Description</small>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark px-2.5 py-2">@item.CategoryProduct?.Name</span>
                            </td>
                            <td class="fw-bold text-danger">
                                @item.Price.ToString("#,##0") đ
                            </td>
                            <td class="text-center">
                                <span class="@(item.StockQuantity < 30 ? "text-warning fw-bold" : "text-dark")">@item.StockQuantity</span>
                            </td>
                            <td class="text-center">
                                <a href="#" class="btn btn-sm btn-outline-warning text-dark border-warning fw-semibold me-1 px-2.5">Sửa</a>
                                <a href="#" class="btn btn-sm btn-outline-danger fw-semibold px-2.5" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>