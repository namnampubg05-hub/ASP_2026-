@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">THÊM SẢN PHẨM MỚI</h4>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="row">

                    <!-- LEFT SIDE -->
                    <div class="col-md-8">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm:</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả sản phẩm:</label>
                            <textarea asp-for="Description" id="Description"
                                      class="form-control" rows="10"
                                      placeholder="Nhập mô tả sản phẩm..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="col-md-4">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán:</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng tồn kho:</label>
                            <input asp-for="StockQuantity" type="number" class="form-control" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục sản phẩm:</label>
                            <select asp-for="CategoryProductId"
                                    class="form-select"
                                    asp-items="ViewBag.CategoryProductList">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh sản phẩm:</label>
                            <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        </div>

                        <hr />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                Lưu sản phẩm
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                Quay lại
                            </a>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {

    <!-- CKEditor -->
    <script src="https://cdn.jsdelivr.net/npm/@@ckeditor/ckeditor5-build-classic@39.0.1/build/ckeditor.js"></script>

    <style>
        .ck-editor__editable_inline {
        min-height: 250px !important;
        }
    </style>

    <script>
        ClassicEditor
        .create(document.querySelector('#Description'))
        .catch(error => console.error(error));
    </script>
}