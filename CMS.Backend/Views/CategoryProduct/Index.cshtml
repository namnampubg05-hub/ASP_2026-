@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    ViewData["Title"] = "Danh mục Sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="letter-spacing: 0.5px;">Danh mục Sản phẩm</h2>
        <a href="#" class="btn btn-success fw-semibold px-3 py-2">
            + Thêm danh mục mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-dark fw-bold border-bottom">
                    <tr>
                        <th style="width: 10%;">ID</th>
                        <th style="width: 30%;">Tên Danh Mục</th>
                        <th style="width: 40%;">Mô Tả Chức Năng</th>
                        <th style="width: 20%;" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium text-secondary">@item.Id</td>
                            <td class="fw-bold text-primary">@item.Name</td>
                            <td class="text-muted">@item.Description</td>
                            <td class="text-center">
                                <a href="#" class="btn btn-sm btn-outline-warning text-dark border-warning fw-semibold me-1 px-2.5">Sửa</a>
                                <a href="#" class="btn btn-sm btn-outline-danger fw-semibold px-2.5" onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>