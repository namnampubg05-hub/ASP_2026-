@model CMS.Data.Entities.Order
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;

    string StatusBadge(int s) => s switch
    {
        0 => "bg-warning text-dark",
        1 => "bg-info text-dark",
        2 => "bg-success",
        3 => "bg-secondary",
        _ => "bg-dark"
    };

    string StatusLabel(int s) => s switch
    {
        0 => "Chờ xác nhận",
        1 => "Đang giao",
        2 => "Đã giao",
        3 => "Đã hủy",
        _ => "Không xác định"
    };
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="letter-spacing: 0.5px;">Chi tiết đơn hàng #@Model.Id</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary fw-semibold me-2">
                <i class="bi bi-pencil"></i> Cập nhật trạng thái
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">← Quay lại</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <strong class="fs-5">Thông tin đơn hàng</strong>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6 mb-2">
                            <strong>Khách hàng:</strong> @Model.Customer?.FullName
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Email:</strong> @Model.Customer?.Email
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Điện thoại:</strong> @Model.Customer?.Phone
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Địa chỉ:</strong> @Model.Customer?.Address
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Trạng thái:</strong>
                            <span class="badge @StatusBadge(Model.Status) px-3 py-2 fw-semibold ms-1">@StatusLabel(Model.Status)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="col-12 mt-2">
                                <strong>Ghi chú:</strong> @Model.Notes
                            </div>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%;">Mã SP</th>
                                    <th style="width: 40%;">Sản phẩm</th>
                                    <th style="width: 15%;" class="text-center">SL</th>
                                    <th style="width: 18%;" class="text-end">Đơn giá</th>
                                    <th style="width: 17%;" class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderDetails != null)
                                {
                                    foreach (var item in Model.OrderDetails)
                                    {
                                        var thanhTien = item.Quantity * item.UnitPrice;
                                        <tr>
                                            <td class="text-secondary">#@item.ProductId</td>
                                            <td class="fw-semibold">@item.Product?.Name</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@item.UnitPrice.ToString("#,##0") đ</td>
                                            <td class="text-end fw-bold text-danger">@thanhTien.ToString("#,##0") đ</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="4" class="text-end fs-5">Tổng cộng:</td>
                                    <td class="text-end fs-5 text-danger">@(Model.OrderDetails?.Sum(od => od.Quantity * od.UnitPrice) ?? 0).ToString("#,##0") đ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
