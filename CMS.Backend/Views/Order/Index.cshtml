@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="letter-spacing: 0.5px;">Quản lý Đơn hàng</h2>
        <a href="#" class="btn btn-success fw-semibold px-3 py-2">
            + Tạo đơn hàng mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-dark fw-bold border-bottom">
                    <tr>
                        <th style="width: 10%;">Mã ĐH</th>
                        <th style="width: 20%;">Ngày Đặt Hàng</th>
                        <th style="width: 25%;">Khách Hàng</th>
                        <th style="width: 20%;">Trạng Thái</th>
                        <th style="width: 25%;">Ghi Chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">#@item.Id</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-dark">@item.Customer?.FullName</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case 1:
                                        <span class="badge bg-warning text-dark px-3 py-2 fw-semibold">Đang xử lý</span>
                                        break;
                                    case 2:
                                        <span class="badge bg-info text-dark px-3 py-2 fw-semibold">Đang vận chuyển</span>
                                        break;
                                    case 3:
                                        <span class="badge bg-success px-3 py-2 fw-semibold">Đã giao hàng</span>
                                        break;
                                    case 4:
                                        <span class="badge bg-secondary px-3 py-2 fw-semibold">Đã hủy</span>
                                        break;
                                    default:
                                        <span class="badge bg-dark px-3 py-2 fw-semibold">Không xác định (@item.Status)</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted small text-truncate" style="max-width: 200px;" title="@item.Notes">
                                @item.Notes
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>