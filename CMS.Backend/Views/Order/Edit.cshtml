@model CMS.Data.Entities.Order
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật đơn hàng #" + Model.Id;

    string StatusBadge(int s) => s switch
    {
        0 => "bg-warning text-dark",
        1 => "bg-info text-dark",
        2 => "bg-success",
        3 => "bg-secondary",
        _ => "bg-dark"
    };

    string StatusLabel(int s) => s switch
    {
        0 => "Chờ xác nhận",
        1 => "Đang giao",
        2 => "Đã giao",
        3 => "Đã hủy",
        _ => "Không xác định"
    };
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="letter-spacing: 0.5px;">Cập nhật đơn hàng #@Model.Id</h2>
        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">← Quay lại</a>
    </div>

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <strong class="fs-5">Thông tin đơn hàng</strong>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6 mb-2">
                            <strong>Khách hàng:</strong> @Model.Customer?.FullName
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Email:</strong> @Model.Customer?.Email
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Điện thoại:</strong> @Model.Customer?.Phone
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Địa chỉ:</strong> @Model.Customer?.Address
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Trạng thái hiện tại:</strong>
                            <span class="badge @StatusBadge(Model.Status) px-3 py-2 fw-semibold ms-1">@StatusLabel(Model.Status)</span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderDetails != null)
                                {
                                    foreach (var item in Model.OrderDetails)
                                    {
                                        var thanhTien = item.Quantity * item.UnitPrice;
                                        <tr>
                                            <td class="fw-semibold">@item.Product?.Name</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@item.UnitPrice.ToString("#,##0") đ</td>
                                            <td class="text-end fw-bold text-danger">@thanhTien.ToString("#,##0") đ</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="3" class="text-end fs-5">Tổng cộng:</td>
                                            <td class="text-end fs-5 text-danger">@(Model.OrderDetails?.Sum(od => od.Quantity * od.UnitPrice) ?? 0).ToString("#,##0") đ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <strong class="fs-5">Cập nhật trạng thái</strong>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select name="status" class="form-select form-select-lg">
                                <option value="0" selected="@(Model.Status == 0)">Chờ xác nhận</option>
                                <option value="1" selected="@(Model.Status == 1)">Đang giao</option>
                                <option value="2" selected="@(Model.Status == 2)">Đã giao</option>
                                <option value="3" selected="@(Model.Status == 3)">Đã hủy</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ghi chú</label>
                            <textarea name="notes" class="form-control" rows="3">@Model.Notes</textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">Lưu thay đổi</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
