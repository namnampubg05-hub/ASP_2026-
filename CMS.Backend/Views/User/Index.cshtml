@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
}

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ THÀNH VIÊN</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm thành viên mới
        </a>
    </div>


    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-dark fw-bold border-bottom">
                    <tr>
                        <th style="width: 8%;">ID</th>
                        <th style="width: 25%;">Tên Đăng Nhập</th>
                        <th style="width: 30%;">Họ Và Tên</th>
                        <th style="width: 17%;">Quyền Hạn</th>
                        <th style="width: 20%;" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-medium text-secondary">@user.Id</td>
                            <td class="fw-bold text-dark">@user.Username</td>
                            <td>@user.FullName</td>
                            <td>
                                @if (user.Role?.ToLower() == "admin" || user.Role?.ToLower() == "administrator")
                                {
                                    <span class="badge bg-danger px-3 py-2 text-uppercase" style="font-size: 0.75rem;">Administrator</span>
                                }
                                else if (user.Role?.ToLower() == "editor")
                                {
                                    <span class="badge bg-info text-dark px-3 py-2 text-uppercase" style="font-size: 0.75rem;">Editor</span>
                                }
                                else if (user.Role?.ToLower() == "moderator")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 text-uppercase" style="font-size: 0.75rem;">Moderator</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 text-uppercase" style="font-size: 0.75rem;">@user.Role</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-warning">
                                    Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @user.Username không?')">
                                    Xóa
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>