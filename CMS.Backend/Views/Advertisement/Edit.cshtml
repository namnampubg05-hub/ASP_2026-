@model CMS.Data.Entities.Advertisement
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật quảng cáo";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CẬP NHẬT QUẢNG CÁO</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedDate" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề quảng cáo..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Accent (từ nhấn mạnh)</label>
                            <input asp-for="Accent" class="form-control" placeholder="Ví dụ: Nước Giải Khát, Chính Hãng..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả ngắn cho quảng cáo..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Badge (nhãn)</label>
                            <input asp-for="BadgeText" class="form-control" placeholder="Ví dụ: 🔥 Giảm đến 50% hôm nay..." />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">URL hình ảnh <span class="text-danger">*</span></label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mt-2">
                                    <small class="text-muted d-block">Ảnh hiện tại:</small>
                                    <img src="@Model.ImageUrl"
                                         style="height:80px;object-fit:cover;border-radius:6px;border:1px solid #ddd;"
                                         class="img-thumbnail mt-1"
                                         onerror="this.style.display='none'"
                                         alt="" />
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Link đích (khi click)</label>
                            <input asp-for="LinkUrl" class="form-control" placeholder="https://..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Thứ tự hiển thị</label>
                            <input asp-for="SortOrder" type="number" class="form-control" />
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label fw-bold">Kích hoạt</label>
                        </div>

                        <hr />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning text-dark fw-bold">
                                <i class="bi bi-cloud-arrow-up"></i> Cập nhật quảng cáo
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
